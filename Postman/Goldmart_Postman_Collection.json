{
  "info": {
    "name": "Goldmart API Collection",
    "description": "Postman & Bruno Collection for testing Goldmart JWT Authentication, Product Catalog, Image Uploads, and Order APIs",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Auth - Register",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Priyamtha User\",\n  \"email\": \"priyamtha@goldmart.com\",\n  \"password\": \"password123\",\n  \"role\": \"customer\"\n}"
        },
        "url": {
          "raw": "http://localhost:5000/api/auth/register",
          "protocol": "http",
          "host": ["localhost"],
          "port": "5000",
          "path": ["api", "auth", "register"]
        }
      }
    },
    {
      "name": "Auth - Login",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"admin@goldmart.com\",\n  \"password\": \"admin123\"\n}"
        },
        "url": {
          "raw": "http://localhost:5000/api/auth/login",
          "protocol": "http",
          "host": ["localhost"],
          "port": "5000",
          "path": ["api", "auth", "login"]
        }
      }
    },
    {
      "name": "Products - Get All",
      "request": {
        "method": "GET",
        "url": {
          "raw": "http://localhost:5000/api/products?category=Necklaces&purity=22K",
          "protocol": "http",
          "host": ["localhost"],
          "port": "5000",
          "path": ["api", "products"],
          "query": [
            { "key": "category", "value": "Necklaces" },
            { "key": "purity", "value": "22K" }
          ]
        }
      }
    },
    {
      "name": "Products - Upload Image (Cloudinary)",
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "formdata",
          "formdata": [
            {
              "key": "image",
              "type": "file",
              "src": []
            }
          ]
        },
        "url": {
          "raw": "http://localhost:5000/api/products/upload-image",
          "protocol": "http",
          "host": ["localhost"],
          "port": "5000",
          "path": ["api", "products", "upload-image"]
        }
      }
    },
    {
      "name": "Orders - Place Order",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{jwt_token}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"orderItems\": [\n    {\n      \"product\": \"prod_seed_1\",\n      \"name\": \"Royal Heritage 22K Gold Bridal Choker Necklace\",\n      \"image\": \"https://images.unsplash.com/photo-1599643478518-a784e5dc4c8f?w=800\",\n      \"purity\": \"22K\",\n      \"weightGrams\": 42.5,\n      \"price\": 338870,\n      \"qty\": 1\n    }\n  ],\n  \"shippingAddress\": {\n    \"street\": \"102 Gold Avenue\",\n    \"city\": \"Mumbai\",\n    \"state\": \"Maharashtra\",\n    \"pincode\": \"400001\"\n  },\n  \"paymentMethod\": \"UPI\",\n  \"goldRateApplied\": 7200,\n  \"itemsPrice\": 329000,\n  \"taxPrice\": 9870,\n  \"totalPrice\": 338870\n}"
        },
        "url": {
          "raw": "http://localhost:5000/api/orders",
          "protocol": "http",
          "host": ["localhost"],
          "port": "5000",
          "path": ["api", "orders"]
        }
      }
    }
  ]
}
